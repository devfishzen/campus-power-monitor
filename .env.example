# ===== 数据源 =====
# ecode: 查询真实数据；mock: 演示数据
PROVIDER=ecode

# ===== 调度 =====
# cron：分 时 日 月 周。默认每天 08:30 查一次
CHECK_CRON=30 8 * * *
TIMEZONE=Asia/Shanghai
# 启动 3 秒后先跑一次，方便验证配置
RUN_ON_START=true

# ===== 告警规则 =====
# 剩余电量低于该值（度）时发邮件
THRESHOLD_KWH=30
# 同一类告警的冷却时间（小时），避免每轮都发
ALERT_COOLDOWN_HOURS=20

# ===== 存储 =====
DB_PATH=/data/dianfei.db
OVERRIDES_PATH=/data/overrides.json

# ===== Web 设置页（HTTP Basic）=====
# ADMIN_PASSWORD 留空则设置页关闭；建议用随机密码
ADMIN_USER=admin
ADMIN_PASSWORD=

# ===== 校园e码通「智能水电」=====
# 实际接口是完美校园 H5，只需要学号 + 学校编号 + 房间号
ECODE_BASE_URL=https://xqh5.17wanxiao.com/smartWaterAndElectricityService
ECODE_ACCOUNT=
# 学校编号：抓包时 e码通跳转 URL 里的 customerid，例如 2178
ECODE_CUSTOMERCODE=
# 房间名：小程序「智能水电」页面顶部，例如 A栋-101
ECODE_ROOM=
# 可选；填了就不按房间名匹配，直接用它查
ECODE_ROOMVERIFY=

# ===== QQ 邮箱 SMTP =====
# SMTP_PASS 填“授权码”，不是 QQ 密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# ===== 手动触发接口 POST /api/run 的令牌 =====
# 留空则不校验；只要端口不对公网，留空也可以
API_TOKEN=

# ===== mock 演示值 =====
MOCK_REMAINING_KWH=100.0
MOCK_TODAY_KWH=20
